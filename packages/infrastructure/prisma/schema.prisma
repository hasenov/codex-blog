generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model User {
    id           String   @id
    email        String   @unique
    displayName  String
    role         String
    status       String
    passwordHash String
    createdAt    DateTime
    updatedAt    DateTime

    sessions        Session[]
    securityEvents  SecurityEvent[]
    passwordResets  PasswordResetToken[]
    authoredPosts   Post[]         @relation("PostAuthor")
    postRevisions   PostRevision[] @relation("PostRevisionCreator")

    @@map("users")
}

model Post {
    id            String    @id
    authorId      String
    title         String
    slug          String    @unique
    excerpt       String
    contentJson   String
    seoJson       String
    status        String
    publishedAt   DateTime?
    scheduledFor  DateTime?
    archivedAt    DateTime?
    createdAt     DateTime
    updatedAt     DateTime

    author    User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
    revisions PostRevision[]

    @@index([authorId])
    @@index([status])
    @@index([publishedAt])
    @@index([scheduledFor])
    @@map("posts")
}

model PostRevision {
    id              String   @id
    postId          String
    number          Int
    title           String
    excerpt         String
    contentJson     String
    seoJson         String
    createdAt       DateTime
    createdByUserId String

    post          Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    createdByUser User @relation("PostRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

    @@unique([postId, number])
    @@index([postId])
    @@index([createdByUserId])
    @@map("post_revisions")
}

model Session {
    id                  String    @id
    userId              String
    refreshTokenId      String    @unique
    createdAt           DateTime
    expiresAt           DateTime
    revokedAt           DateTime?
    replacedBySessionId String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("sessions")
}

model SecurityEvent {
    id            String   @id
    type          String
    userId        String
    occurredAt    DateTime
    correlationId String
    metadataJson  String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("security_events")
}

model PasswordResetToken {
    token     String   @id
    userId    String
    expiresAt DateTime
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("password_reset_tokens")
}
