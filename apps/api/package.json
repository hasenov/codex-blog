        "@codex-blog/infrastructure": "workspace:*",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.1.0",
        "pino-http": "^10.4.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.1",
        "@types/supertest": "^7.2.0",
        "supertest": "^7.2.2",
        "tsx": "^4.19.3"
    }
