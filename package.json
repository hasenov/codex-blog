{
    "name": "codex-blog",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.26.2",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev --parallel",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "db:generate": "pnpm --filter @codex-blog/infrastructure prisma:generate",
        "db:migrate:dev": "pnpm --filter @codex-blog/infrastructure prisma:migrate:dev",
        "db:migrate:deploy": "pnpm --filter @codex-blog/infrastructure prisma:migrate:deploy",
        "seed:admin": "pnpm --filter @codex-blog/api seed:admin"
    },
    "devDependencies": {
        "@eslint/js": "^9.24.0",
        "@types/node": "^22.14.0",
        "@typescript-eslint/eslint-plugin": "^8.29.0",
        "@typescript-eslint/parser": "^8.29.0",
        "eslint": "^9.24.0",
        "turbo": "^2.5.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.29.0",
        "vitest": "^3.1.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "esbuild",
            "prisma"
        ]
    }
}
